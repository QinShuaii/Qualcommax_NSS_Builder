#
# 1 GB ipq807x profile group, reduced to the one board this fork builds for.
#
# Concatenated onto devices/common/config by prepare-build.sh. The group exists
# because the ath11k and NSS memory profiles are compile-time and image-wide, so
# boards can only share a build when they share a profile. The full upstream
# 1G board list lives in git history (commit 3803703) if more boards are ever
# needed again - re-add the CONFIG_TARGET_DEVICE lines and keep the two
# profile symbols below untouched.
#

CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_HIGH=y

CONFIG_TARGET_DEVICE_qualcommax_ipq807x_DEVICE_redmi_ax6-stock=y
